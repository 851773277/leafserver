    "version": "0.2.0",
    "configurations": [
        {
            "name": "leaf_launch",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "cwd" : "${workspaceFolder}/bin",
            "program": "${workspaceFolder}/bin/server",
            "args": ["./conf/server.json"]
        },
        {
            "name": "leaf_attach",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": "${command:pickProcess}",
        }
    ]
}